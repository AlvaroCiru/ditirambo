# Copia este archivo a .env.local y rellena los valores desde el panel de tu
# proyecto Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta ("secret key" / service role). Solo se usa en el servidor
# (nunca lleva el prefijo NEXT_PUBLIC_) para poder cambiar el nombre de
# usuario desde la página de perfil sin depender de un email real.
# NO compartir ni exponer nunca esta clave.
SUPABASE_SECRET_KEY=

# --- Avisos web (opcional, capa desconectable) ---
# Pon NEXT_PUBLIC_AVISOS_WEB=0 para desactivar avisos sin quitar codigo.
# Generar claves: npx web-push generate-vapid-keys
NEXT_PUBLIC_AVISOS_WEB=0
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
